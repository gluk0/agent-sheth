# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Comma-separated Telegram user IDs allowed to use the bot.
# Find yours by messaging @userinfobot. Empty = nobody can use the bot.
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222

# --- Models / APIs -----------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Default model for agents
GEMINI_MODEL=gemini-2.5-flash
# fal.ai key from https://fal.ai/dashboard/keys (needed for video rendering)
FAL_KEY=

# --- Content pipeline ---------------------------------------------------------
# 'stub' renders free ffmpeg test clips (no cost); 'fal' renders real AI video
VIDEO_BACKEND=stub
# fal.ai text-to-video endpoint (verify at https://fal.ai/models before first run)
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-5b/text-to-video
# Optional: override the harvested RSS feeds (comma-separated URLs)
# RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.space.com/feeds/all

# --- Runtime -----------------------------------------------------------------
# Where the session DB and generated artifacts live
DATA_DIR=data

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# Set true for JSON logs (recommended when running under Docker)
LOG_JSON=false
